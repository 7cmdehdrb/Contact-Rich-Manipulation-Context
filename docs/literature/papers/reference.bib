}

@inproceedings{wu1KHzBehavior2024,
  title = {1 {{kHz Behavior Tree}} for {{Self-adaptable Tactile Insertion}}},
  booktitle = {2024 {{IEEE International Conference}} on {{Robotics}} and {{Automation}} ({{ICRA}})},
  author = {Wu, Yansong and Wu, Fan and Chen, Lingyun and Chen, Kejia and Schneider, Samuel and Johannsmeier, Lars and Bing, Zhenshan and Abu-Dakka, Fares J. and Knoll, Alois and Haddadin, Sami},
  date = {2024-05-13},
