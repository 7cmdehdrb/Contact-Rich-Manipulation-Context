}

@article{dengCoarsetoFineRoboticPushing2025,
  title = {Coarse-to-{{Fine Robotic Pushing Using Touch}}, {{Vision}} and {{Proprioception}}},
  author = {Deng, Bowen and Lin, Yijiong and Yang, Max and Lepora, Nathan F.},
  date = {2025-02},
  journaltitle = {IEEE Robotics and Automation Letters},
  shortjournal = {IEEE Robot. Autom. Lett.},
  volume = {10},
