@inproceedings{uenoMultiFingeredDraggingUnknown2024,
  title = {Multi-{{Fingered Dragging}} of {{Unknown Objects}} and {{Orientations Using Distributed Tactile Information Through Vision-Transformer}} and {{LSTM}}},
  booktitle = {2024 {{IEEE}}/{{RSJ International Conference}} on {{Intelligent Robots}} and {{Systems}} ({{IROS}})},
  author = {Ueno, T. and Funabashi, S. and Ito, H. and Schmitz, A. and Kulkarni, S. and Ogata, T. and Sugano, S.},
