}

@inproceedings{nazariDeepFunctionalPredictive2023,
  title = {Deep {{Functional Predictive Control}} (Deep-{{FPC}}): {{Robot Pushing}} 3-{{D Cluster Using Tactile Prediction}}},
  shorttitle = {Deep {{Functional Predictive Control}} (Deep-{{FPC}})},
  booktitle = {2023 {{IEEE}}/{{RSJ International Conference}} on {{Intelligent Robots}} and {{Systems}} ({{IROS}})},
