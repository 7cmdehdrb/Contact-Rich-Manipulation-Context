  file = {G:\내 드라이브\IROL\논문\storage\G6FAYQ9V\Yang 등 - 2025 - Disambiguate Gripper State in Grasp-Based Tasks Pseudo-Tactile as Feedback Enables Pure Simulation.pdf}
