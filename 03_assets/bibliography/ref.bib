}

@article{zangTwistpullExecutionSkill2026,
  title = {Twist-Pull as an Execution Skill Primitive for Robotic Disassembly: {{Safety-aware}} Skill Augmentation under Contact Uncertainty},
  shorttitle = {Twist-Pull as an Execution Skill Primitive for Robotic Disassembly},
  author = {Zang, Yue and Xu, Xiazhen and Zhang, Yongquan and Zhang, Fan and Deng, Wupeng and Hajiyavand, Amir M. and Wang, Yongjing},
  date = {2026-06},
  journaltitle = {Journal of Manufacturing Systems},
  shortjournal = {J. Manuf. Syst.},
  volume = {86},
  pages = {22--37},
  issn = {02786125},
  doi = {10.1016/j.jmsy.2026.02.020},
  url = {https://linkinghub.elsevier.com/retrieve/pii/S027861252600049X},
  urldate = {2026-09-09},
  abstract = {Structural variability and hidden contact interactions in robotic disassembly impede conventional task-specific control and learning paradigms. This paper formulates twist-pull (TP) as a fundamental execution skill primitive, a generic interaction pattern underpinning diverse disassembly operations, and proposes a safety-aware skill augmentation framework. Distinct from object-specific policy learning, this approach augments the primitive’s compliant baseline via reinforcement learning (RL) to accommodate unmodeled contact dynamics. To ensure safe exploration, the framework integrates a Safety Policy (SP) for velocity stabilisation and employs a structured observation-action architecture. By explicitly decoupling planar motion regulation from axial compliance modulation, this architectural constraint prevents unsafe force-motion coupling during policy optimisation. Experimental validation across structurally diverse components, spanner-type configurations, and real-world products demonstrates that augmenting the TP primitive significantly enhances execution robustness and generalisability, establishing a scalable foundation for contact-rich disassembly automation.},
  langid = {english},
  file = {G:\내 드라이브\IROL\논문\storage\Q7CMNMNZ\Zang 등 - 2026 - Twist-pull as an execution skill primitive for robotic disassembly Safety-aware skill augmentation.pdf}
}

@inproceedings{zhaiPEANUTPredictingNavigating2023,
  title = {{{PEANUT}}: {{Predicting}} and {{Navigating}} to {{Unseen Targets}}},
  shorttitle = {{{PEANUT}}},
  booktitle = {2023 {{IEEE}}/{{CVF International Conference}} on {{Computer Vision}} ({{ICCV}})},
  author = {Zhai, Albert J. and Wang, Shenlong},
